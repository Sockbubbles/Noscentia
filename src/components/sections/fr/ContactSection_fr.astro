import ContactIconBlock from "@components/ui/blocks/ContactIconBlock.astro";

const title: string = "Contactez-nous";
const subTitle: string =
  "Vous souhaitez passer une commande ou avez des questions sur nos produits ? Contactez-nous";
const formTitle: string = "Veuillez remplir le formulaire ci-dessous";
const formSubTitle: string = "Nous vous répondrons sous 1 à 2 jours ouvrables.";
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1 class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight">
        {title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 -2 ">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2 class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300">
          {formTitle}
        </h2>

        <!-- Identique au comportement du formulaire de demo FormSubmit -->
        <form
          id="noscentia-contact"
          target="_blank"
          action="https://formsubmit.co/info@noscentia.com"
          method="POST"
        >
          <!-- Options FormSubmit -->
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />

          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="first-name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Prénom</label>
                <!-- Comme la démo: name="name" -->
                <input
                  id="first-name"
                  name="name"
                  type="text"
                  required
                  class="block w-full rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-2 focus:ring-blue-600"
                  placeholder="Prénom"
                  autocomplete="given-name"
                />
              </div>

              <div>
                <label for="last-name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Nom</label>
                <input
                  id="last-name"
                  name="last_name"
                  type="text"
                  class="block w-full rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-2 focus:ring-blue-600"
                  placeholder="Nom"
                  autocomplete="family-name"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Courriel</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="block w-full rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-2 focus:ring-blue-600"
                placeholder="vous@exemple.com"
                autocomplete="email"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Téléphone</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                class="block w-full rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-2 focus:ring-blue-600"
                placeholder="(optionnel)"
                autocomplete="tel"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Détails</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="block w-full rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 text-neutral-800 dark:text-neutral-200 focus:outline-none focus:ring-2 focus:ring-blue-600"
                placeholder="Dites-nous ce dont vous avez besoin…"
              ></textarea>
            </div>
          </div>

          <div class="mt-4 grid">
            <!-- Bouton de soumission explicite pour ce formulaire -->
            <button
              type="submit"
              form="noscentia-contact"
              formaction="https://formsubmit.co/info@noscentia.com"
              formmethod="POST"
              formtarget="_blank"
              class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg bg-blue-600 px-4 py-3 text-sm font-bold text-white hover:bg-blue-700 transition"
            >
              Envoyer le message
            </button>
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {formSubTitle}
            </p>

            <ContactIconBlock
              heading="Contactez-nous par courriel"
              content="Vous préférez l’écrit ? Envoyez-nous un courriel à"
              isLinkVisible={true}
              linkTitle="info@noscentia.com"
              linkURL="mailto:info@noscentia.com"
            />
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700"></div>
    </div>
  </div>
</section>